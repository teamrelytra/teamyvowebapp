diff --git a/.env.example b/.env.example
new file mode 100644
index 0000000..a3bf864
--- /dev/null
+++ b/.env.example
@@ -0,0 +1,9 @@
+# Set these in Netlify > Site configuration > Environment variables (never commit real values).
+# Discord OAuth2 (https://discord.com/developers/applications). Redirect URI to register:
+#   https://teamyvo.netlify.app/api/discord/callback
+DISCORD_CLIENT_ID=
+DISCORD_CLIENT_SECRET=
+# Optional: only if the redirect URI differs from <site URL>/api/discord/callback
+DISCORD_REDIRECT_URI=
+# Optional: needed only to reset the two older (Supabase) accounts; keep it server-side only.
+SUPABASE_SERVICE_ROLE_KEY=
